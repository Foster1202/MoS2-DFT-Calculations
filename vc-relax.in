&CONTROL
  title='MoS2 Monolayer vc-relax', 
  calculation='vc-relax',
  pseudo_dir='./', 
  outdir='./tmp', 
  verbosity='high',
  tprnfor=.true., 
  tstress=.true., 
  etot_conv_thr=1.0d-5,
  forc_conv_thr=1.0d-4, 
  nstep=100,
/
&SYSTEM
  ibrav= 0, 
  nat= 3, 
  ntyp= 2, 
  occupations = 'smearing', 
  smearing = 'gauss', 
  degauss = 1.0d-2,
  ecutwfc = 60,
  ecutrho = 600,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_beta = 0.7d0,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press_conv_thr = 0.1,
  cell_dofree = '2Dxy',
/

ATOMIC_SPECIES
  Mo 95.94   mo_pbe_v1.uspp.F.UPF
  S  32.066  s_pbe_v1.4.uspp.F.UPF

